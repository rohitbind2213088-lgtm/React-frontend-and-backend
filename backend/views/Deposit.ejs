<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Deposit</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background-color: #f4f7fb;
        }

        .container {
            width: 500px;
            margin: 50px auto;
            padding: 30px 40px;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.12);
        }

        h1 {
            text-align: center;
            color: #1f2937;
            margin-bottom: 30px;
        }

        label {
            display: block;
            margin-top: 15px;
            margin-bottom: 7px;
            font-weight: bold;
            color: #374151;
        }

        input {
            width: 100%;
            height: 42px;
            padding: 0 12px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 15px;
        }

        input:focus {
            border-color: #2563eb;
            outline: none;
        }

        .button-box {
            text-align: center;
            margin-top: 30px;
        }

        button {
            width: 150px;
            height: 45px;
            border: none;
            border-radius: 6px;
            background-color: #2563eb;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin: 5px;
        }

        button:hover {
            background-color: #1d4ed8;
        }


        #paymentPage {
            display: none;
            text-align: center;
        }

        .payment-box {
            margin-top: 20px;
            padding: 25px;
            background-color: #f8fafc;
            border: 2px solid #2563eb;
            border-radius: 10px;
        }

        .payment-amount {
            font-size: 35px;
            font-weight: bold;
            color: #16a34a;
            margin: 20px 0;
        }

        .pay-button {
            background-color: #16a34a;
        }

        .pay-button:hover {
            background-color: #15803d;
        }

        .back-button {
            background-color: #ef4444;
        }

        .back-button:hover {
            background-color: #dc2626;
        }

        /* Success Page */
        #successPage {
            display: none;
            text-align: center;
        }

        .success-icon {
            font-size: 80px;
            color: #16a34a;
            margin-bottom: 10px;
        }

        .success-message {
            font-size: 32px;
            font-weight: bold;
            color: #16a34a;
            margin: 20px 0;
        }

        .success-info {
            font-size: 18px;
            color: #374151;
            line-height: 1.8;
        }

        .success-back {
            background-color: #2563eb;
            margin-top: 25px;
        }


        @media (max-width: 600px) {
            .container {
                width: 100%;
                margin: 20px auto;
                padding: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="container">



        <div id="depositPage">

            <h1>Deposit Money</h1>

            <form id="depositForm">

                <label>Account No.</label>

                <input type="text" id="account" placeholder="Enter Account Number" required>

                <label>Deposit Amount</label>

                <input type="number" id="amount" placeholder="Enter Amount" min="1" required>

                <div class="button-box">

                    <button type="submit">
                        Deposit
                    </button>

                </div>

            </form>

        </div>


        <div id="paymentPage">

            <h1>Payment</h1>

            <div class="payment-box">

                <p>Account No.</p>

                <h3 id="paymentAccount"></h3>

                <p>Deposit Amount</p>

                <div class="payment-amount">
                    ₹<span id="paymentAmount">0</span>
                </div>

                <div>

                    <button class="pay-button" onclick="payNow()">
                        Pay
                    </button>

                    <button class="back-button" onclick="backToDeposit()">
                        Back
                    </button>

                </div>

            </div>

        </div>


        <div id="successPage">

            <div class="success-icon">
                ✓
            </div>

            <div class="success-message">
                Payment Successful
            </div>

            <div class="success-info">

                <p>
                    Your payment has been completed successfully.
                </p>

                <p>
                    Account No:
                    <b id="successAccount"></b>
                </p>

                <p>
                    Amount:
                    <b>₹<span id="successAmount"></span></b>
                </p>

            </div>

            <button class="success-back" onclick="backToDeposit()">
                Back to Deposit
            </button>

        </div>

    </div>


    <script>

        const form = document.getElementById("depositForm");

        form.addEventListener("submit", function (event) {

            event.preventDefault();


            const account =
                document.getElementById("account").value;


            const amount =
                document.getElementById("amount").value;



            document.getElementById("paymentAccount").innerText =
                account;

            document.getElementById("paymentAmount").innerText =
                amount;


            document.getElementById("depositPage").style.display =
                "none";

            document.getElementById("paymentPage").style.display =
                "block";

        });



        function payNow() {

            const account =
                document.getElementById("paymentAccount").innerText;

            const amount =
                document.getElementById("paymentAmount").innerText;


            document.getElementById("successAccount").innerText =
                account;

            document.getElementById("successAmount").innerText =
                amount;



            document.getElementById("paymentPage").style.display =
                "none";



            document.getElementById("successPage").style.display =
                "block";

        }

        function backToDeposit() {

            document.getElementById("paymentPage").style.display =
                "none";

            document.getElementById("successPage").style.display =
                "none";
            document.getElementById("depositPage").style.display =
                "block";

        }

    </script>

</body>

</html>