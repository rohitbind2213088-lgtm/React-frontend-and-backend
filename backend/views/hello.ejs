<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #f2f2f2;
        }

        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            margin-top: 80px;
        }

        form {
            width: 350px;
            padding: 25px;
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        input {
            width: 100%;
            height: 40px;
            margin-bottom: 15px;
            padding: 0 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 15px;
        }

        input:focus {
            outline: none;
            border-color: #007bff;
        }

        button {
            width: 48%;
            height: 40px;
            border: none;
            border-radius: 5px;
            color: white;
            font-size: 15px;
            cursor: pointer;
            margin-bottom: 10px;
        }

        button[value="insert"] {
            background-color: #28a745;
        }

        button[value="update"] {
            background-color: #007bff;
        }

        button[value="delete"]{
          background-color: red;
        }
        
        button[value="show"]{
          background-color: black;
        }
        button:hover {
            opacity: 0.85;
        }
        .student{
                  display:flex;
                  justify-content: center;
                  align-items: center;
                  color: red;
        }
    </style>
</head>
<body>
    <div class="container">
      
    <form action="/test" method="get">
       <h2 class="student">STUDENT FILE</h2>

        <input type="text" name="name" placeholder="Enter name">

        <input type="text" name="email" placeholder="Enter email">

        <input type="text" name="password" placeholder="Enter password">

        <input type="text" name="mobile" placeholder="Enter mobile">

        <!-- <input type='submit' name='cmd' value='update'>
        <input type='submit' name='cmd' value='insert'> -->
         <button type="submit" name="cmd" value="update">Update</button>
         <button type="submit" name="cmd" value="insert">Insert</button>
         <button type="submit" name="cmd" value="delete">delete</button>
         <button type="submit" name="cmd" value="show">show</button>
        </form>
        </body>
</body>
</html>